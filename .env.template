# Microsoft Fabric BCDR Configuration
# Copy this file to .env and update with your environment values

# Fabric Workspace GUIDs (primary region)
PRIMARY_WORKSPACE_ID=your-primary-workspace-guid

# Fabric Workspace GUIDs (secondary region)
SECONDARY_WORKSPACE_ID=your-secondary-workspace-guid

# Fabric Capacity IDs
PRIMARY_CAPACITY_ID=your-primary-capacity-id
SECONDARY_CAPACITY_ID=your-secondary-capacity-id

# Azure AD Service Principal (requires Workspace Admin role in both workspaces)
TENANT_ID=your-azure-tenant-id
CLIENT_ID=your-service-principal-client-id
CLIENT_SECRET=your-service-principal-client-secret

# Sync Performance Settings
NUM_THREADS=5                    # Parallel threads for operations
RESPONSE_BACKOFF=2               # Seconds between retries (exponential backoff)
MAX_RETRIES=3                    # Max retry attempts for failed API calls
OPERATION_TIMEOUT_SECONDS=300    # Timeout for async operations (5 minutes)

# Feature Flags
GIT_INTEGRATION_ENABLED=false    # Use Git for artifact export (if available)
